.paper-page.quiz-page {
  display: flex;
  min-height: calc(100vh - 168rpx);
  flex-direction: column;
}

.quiz-progress__meta {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 26rpx;
}

.quiz-progress__count {
  color: #945ee8;
  font-size: 40rpx;
  font-weight: 900;
}

.quiz-progress__type {
  color: #6e6671;
  font-size: 24rpx;
  font-weight: 800;
}

.quiz-progress {
  height: 14rpx;
  margin-top: 24rpx;
  overflow: hidden;
  background: #eadffc;
  border-radius: 999rpx;
}

.quiz-progress__bar {
  height: 100%;
  background: #a66ee9;
  border-radius: inherit;
  transition: width 180ms ease;
}

.quiz-question {
  display: block;
  max-width: 380rpx;
  min-height: 118rpx;
  margin-top: 54rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.4;
}

.quiz-options {
  display: flex;
  gap: 24rpx;
  margin-top: 68rpx;
  flex-direction: column;
}

.quiz-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 82rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 18rpx 30rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: left;
  background: #fffdf8;
  border: 4rpx solid #201b22;
  border-radius: 999rpx;
}

.quiz-option--selected {
  background: #bd96f4;
}

.quiz-option__check {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: #fffdf8;
  font-size: 34rpx;
  font-weight: 900;
}

.quiz-actions {
  display: flex;
  gap: 56rpx;
  margin-top: auto;
  padding-top: 54rpx;
}

.quiz-actions__button {
  flex: 1;
}
