.detail-page {
  display: flex;
  min-height: calc(100vh - 120rpx);
  flex-direction: column;
}

.detail-page--pair {
  padding-top: 18rpx;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.single-detail-hero {
  display: block;
  width: 648rpx;
  height: 294rpx;
  margin-top: 22rpx;
}

.detail-tags,
.pair-detail-tags {
  display: flex;
}

.detail-tags {
  gap: 14rpx;
  margin-top: 34rpx;
}

.detail-tag {
  min-width: 128rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
  border: 4rpx solid #201b22;
  border-radius: 999rpx;
}

.detail-tag--yellow,
.pair-detail-tag--yellow {
  background: #ffd86a;
}

.detail-tag--purple,
.pair-detail-tag--purple {
  background: #c7a5ff;
}

.detail-tag--mint,
.pair-detail-tag--mint {
  background: #a9e2cf;
}

.detail-title {
  margin-top: 26rpx;
  font-size: 39rpx;
  font-weight: 900;
  line-height: 1.35;
}

.detail-description {
  margin-top: 10rpx;
  color: #6e6671;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-rules {
  display: flex;
  min-height: 258rpx;
  gap: 24rpx;
  margin-top: 62rpx;
  padding: 38rpx 30rpx;
  flex-direction: column;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.detail-action {
  margin-top: auto;
  margin-bottom: 128rpx;
}

.pair-detail-hero {
  display: block;
  width: 648rpx;
  height: 284rpx;
}

.pair-detail-tags {
  gap: 12rpx;
  margin-top: 34rpx;
}

.pair-detail-tag {
  padding: 11rpx 22rpx;
  font-size: 22rpx;
  font-weight: 900;
  border: 3rpx solid #201b22;
  border-radius: 999rpx;
  white-space: nowrap;
}

.pair-detail-tag--yellow {
  background: #ffd867;
}

.pair-detail-tag--mint {
  background: #a9e1cc;
}

.pair-detail-tag--purple {
  background: #c5a0f4;
}

.pair-detail-title {
  display: block;
  margin-top: 24rpx;
  font-size: 39rpx;
  font-weight: 900;
}

.pair-detail-copy {
  display: block;
  margin-top: 12rpx;
  color: #6e6671;
  font-size: 24rpx;
  font-weight: 800;
}

.pair-detail-steps {
  display: flex;
  min-height: 244rpx;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 52rpx;
  padding: 38rpx 28rpx 14rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.pair-detail-steps__note {
  margin-top: 4rpx;
  color: #6e6671;
  font-size: 21rpx;
}

.pair-detail-actions {
  margin-top: auto;
  padding-top: 60rpx;
}

.pair-detail-actions .paper-button + .paper-button {
  margin-top: 20rpx;
}
