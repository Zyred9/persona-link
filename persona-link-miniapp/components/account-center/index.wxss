:host {
  display: block;
  min-height: 100%;
}

.profile-page {
  padding-top: 30rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 46rpx 38rpx;
}

.profile-face {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  flex: 0 0 auto;
  background: #ff9690;
  border: 5rpx solid #201b22;
  border-radius: 50%;
}

.profile-heart {
  position: absolute;
  top: 47rpx;
  left: 50%;
  width: 42rpx;
  height: 42rpx;
  background: #ff7469;
  border-right: 5rpx solid #201b22;
  border-bottom: 5rpx solid #201b22;
  transform: translateX(-50%) rotate(45deg);
}

.profile-heart::before,
.profile-heart::after {
  position: absolute;
  width: 42rpx;
  height: 42rpx;
  box-sizing: border-box;
  content: '';
  background: #ff7469;
  border: 5rpx solid #201b22;
  border-radius: 50%;
}

.profile-heart::before {
  top: -23rpx;
  left: -5rpx;
  border-bottom-color: transparent;
}

.profile-heart::after {
  top: -5rpx;
  left: -23rpx;
  border-right-color: transparent;
}

.profile-cheek {
  position: absolute;
  bottom: 49rpx;
  width: 20rpx;
  height: 20rpx;
  background: #f5b1c5;
  border-radius: 50%;
}

.profile-cheek--left {
  left: 18rpx;
}

.profile-cheek--right {
  right: 18rpx;
}

.profile-smile {
  position: absolute;
  bottom: 28rpx;
  left: 50%;
  width: 46rpx;
  height: 22rpx;
  border-bottom: 5rpx solid #201b22;
  border-radius: 0 0 40rpx 40rpx;
  transform: translateX(-50%);
}

.profile-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  margin-left: 44rpx;
}

.profile-badge {
  padding: 9rpx 30rpx;
  font-size: 23rpx;
  font-weight: 900;
  background: #ffd866;
  border: 4rpx solid #201b22;
  border-radius: 999rpx;
}

.profile-title {
  margin-top: 20rpx;
  font-size: 37rpx;
  font-weight: 900;
}

.profile-description {
  margin-top: 14rpx;
  color: #6e6671;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.55;
}

.profile-menu {
  margin-top: 52rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 90rpx;
  margin-bottom: 12rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  font-weight: 900;
  text-align: left;
}

.profile-row__hint,
.profile-row__arrow {
  color: #817d81;
  font-size: 23rpx;
  font-weight: 800;
}

.profile-row__arrow {
  font-size: 42rpx;
}

.history-page {
  padding-top: 22rpx;
}

.history-summary {
  display: flex;
  height: 68rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #fffdf8;
  border: 4rpx solid #201b22;
  border-radius: 999rpx;
}

.history-summary__item {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: #6e6671;
  font-size: 26rpx;
  font-weight: 900;
}

.history-summary__item--active {
  color: #945ee8;
}

.history-summary__item--active::after {
  position: absolute;
  right: 36rpx;
  bottom: 0;
  left: 36rpx;
  height: 6rpx;
  content: '';
  background: #945ee8;
}

.history-section-title {
  display: block;
  margin-top: 34rpx;
}

.history-record {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 160rpx;
  margin-bottom: 52rpx;
  padding: 26rpx 28rpx;
  text-align: left;
}

.history-record--single {
  padding-left: 192rpx;
}

.history-record--pair {
  min-height: 166rpx;
  padding: 32rpx 28rpx;
}

.history-record__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.history-record__more {
  position: absolute;
  top: 26rpx;
  right: 22rpx;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 5rpx;
}

.history-record__title {
  font-size: 27rpx;
  font-weight: 900;
}

.history-record__result {
  margin-top: 8rpx;
  color: #945ee8;
  font-size: 26rpx;
  font-weight: 900;
}

.history-record--single .history-record__result,
.history-record--waiting .history-record__result {
  color: #ff7469;
}

.history-record__meta {
  margin-top: 8rpx;
  color: #817d81;
  font-size: 21rpx;
  font-weight: 800;
}

.history-face {
  position: absolute;
  bottom: -36rpx;
  left: 36rpx;
  width: 140rpx;
  height: 140rpx;
  background: #ffd866;
  border: 5rpx solid #201b22;
  border-radius: 50%;
}

.history-face__eye {
  position: absolute;
  top: 58rpx;
  width: 17rpx;
  height: 17rpx;
  background: #201b22;
  border-radius: 50%;
}

.history-face__eye--left {
  left: 38rpx;
}

.history-face__eye--right {
  right: 38rpx;
}

.history-face__cheek {
  position: absolute;
  top: 83rpx;
  width: 20rpx;
  height: 20rpx;
  background: #f5b1c5;
  border-radius: 50%;
}

.history-face__cheek--left {
  left: 17rpx;
}

.history-face__cheek--right {
  right: 17rpx;
}

.history-face__smile {
  position: absolute;
  bottom: 29rpx;
  left: 50%;
  width: 46rpx;
  height: 22rpx;
  border-bottom: 5rpx solid #201b22;
  border-radius: 0 0 30rpx 30rpx;
  transform: translateX(-50%);
}

.feedback-page {
  padding-top: 34rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.feedback-guide {
  display: block;
  color: #6e6671;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.55;
}

.feedback-input {
  width: 100%;
  height: 378rpx;
  box-sizing: border-box;
  margin-top: 54rpx;
  padding: 32rpx 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.55;
}

.feedback-input__placeholder {
  color: #aaa2af;
  font-weight: 800;
}

.feedback-note {
  margin-top: 32rpx;
  padding: 32rpx 28rpx;
  color: #6e6671;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.55;
  background: #fff3d2;
}

.feedback-submit {
  position: fixed;
  right: 60rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  left: 60rpx;
  width: auto;
}

.settings-page {
  padding-top: 10rpx;
}

.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 86rpx;
  margin-bottom: 10rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 900;
  text-align: left;
}

.settings-row__arrow {
  color: #817d81;
  font-size: 40rpx;
}

.settings-row__value {
  color: #817d81;
  font-size: 24rpx;
}

.settings-about {
  margin-top: 44rpx;
}
