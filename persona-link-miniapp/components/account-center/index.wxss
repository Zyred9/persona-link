:host {
  display: block;
  min-height: 100%;
}

.profile-page {
  padding-top: 30rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 46rpx 38rpx;
}

.profile-face {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  flex: 0 0 auto;
  background: #ff9690;
  border: 5rpx solid #201b22;
  border-radius: 50%;
}

.profile-heart {
  position: absolute;
  top: 47rpx;
  left: 50%;
  width: 42rpx;
  height: 42rpx;
  background: #ff7469;
  border-right: 5rpx solid #201b22;
  border-bottom: 5rpx solid #201b22;
  transform: translateX(-50%) rotate(45deg);
}

.profile-heart::before,
.profile-heart::after {
  position: absolute;
  width: 42rpx;
  height: 42rpx;
  box-sizing: border-box;
  content: '';
  background: #ff7469;
  border: 5rpx solid #201b22;
  border-radius: 50%;
}

.profile-heart::before {
  top: -23rpx;
  left: -5rpx;
  border-bottom-color: transparent;
}

.profile-heart::after {
  top: -5rpx;
  left: -23rpx;
  border-right-color: transparent;
}

.profile-cheek {
  position: absolute;
  bottom: 49rpx;
  width: 20rpx;
  height: 20rpx;
  background: #f5b1c5;
  border-radius: 50%;
}

.profile-cheek--left {
  left: 18rpx;
}

.profile-cheek--right {
  right: 18rpx;
}

.profile-smile {
  position: absolute;
  bottom: 28rpx;
  left: 50%;
  width: 46rpx;
  height: 22rpx;
  border-bottom: 5rpx solid #201b22;
  border-radius: 0 0 40rpx 40rpx;
  transform: translateX(-50%);
}

.profile-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  margin-left: 44rpx;
}

.profile-badge {
  padding: 9rpx 30rpx;
  font-size: 23rpx;
  font-weight: 900;
  background: #ffd866;
  border: 4rpx solid #201b22;
  border-radius: 999rpx;
}

.profile-title {
  margin-top: 20rpx;
  font-size: 37rpx;
  font-weight: 900;
}

.profile-description {
  margin-top: 14rpx;
  color: #6e6671;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.55;
}

.profile-menu {
  margin-top: 52rpx;
}

.profile-avatar {
  min-height: 0;
  margin: 0;
  padding: 0;
  overflow: hidden;
}

.profile-avatar[disabled] {
  background: #ff9690;
}

.profile-avatar::after,
.profile-name-save::after {
  border: 0;
}

.profile-avatar__image {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-name-form {
  display: block;
  width: 100%;
}

.profile-action { margin-top: 24rpx; }
.profile-nickname {
  width: 100%;
  height: 56rpx;
  padding: 0;
}
.profile-nickname__placeholder {
  color: #201b22;
}
.profile-name-save {
  width: auto;
  min-height: 0;
  margin: 8rpx 0 0;
  padding: 6rpx 22rpx;
  color: #201b22;
  font-size: 24rpx;
  line-height: 1.5;
  background: #ffd866;
  border: 3rpx solid #201b22;
  border-radius: 999rpx;
}
.profile-hint {
  font-size: 20rpx;
}
.profile-error {
  margin-top: 20rpx;
  color: #b83f38;
  font-size: 24rpx;
  overflow-wrap: break-word;
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 90rpx;
  margin-bottom: 12rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  font-weight: 900;
  text-align: left;
}

.profile-row__hint,
.profile-row__arrow {
  color: #817d81;
  font-size: 23rpx;
  font-weight: 800;
}

.profile-row__arrow {
  font-size: 42rpx;
}

.history-page {
  padding-top: 22rpx;
  min-height: 0;
}

.history-panel {
  animation-duration: 220ms;
  animation-timing-function: ease-out;
}

.history-panel--single {
  animation-name: history-panel-in-left;
}

.history-panel--pair {
  animation-name: history-panel-in-right;
}

@keyframes history-panel-in-left {
  from { opacity: 0; transform: translateX(-56rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes history-panel-in-right {
  from { opacity: 0; transform: translateX(56rpx); }
  to { opacity: 1; transform: translateX(0); }
}

.history-summary {
  display: flex;
  height: 68rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #fffdf8;
  border: 4rpx solid #201b22;
  border-radius: 999rpx;
}

.history-summary__item {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: #6e6671;
  font-size: 26rpx;
  font-weight: 900;
}

.history-summary__item--active {
  color: #945ee8;
}

.history-summary__item--active::after {
  position: absolute;
  right: 36rpx;
  bottom: 0;
  left: 36rpx;
  height: 6rpx;
  content: '';
  background: #945ee8;
}

.history-section-title {
  display: block;
  margin-top: 34rpx;
}

.history-record {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 160rpx;
  margin-bottom: 52rpx;
  padding: 26rpx 28rpx;
  text-align: left;
}

.history-record--single {
  padding-left: 192rpx;
}

.history-record--pair {
  min-height: 166rpx;
  padding: 32rpx 28rpx 32rpx 192rpx;
}

.history-record__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.history-record__more {
  display: flex;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 88rpx;
  margin: 0 0 0 8rpx;
  padding: 0;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 5rpx;
}

.history-record__invite {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  margin: 0 0 0 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 900;
  background: #ffd867;
  border: 3rpx solid #201b22;
  border-radius: 999rpx;
}

.history-record__title {
  font-size: 27rpx;
  font-weight: 900;
}

.history-record__result {
  margin-top: 8rpx;
  color: #945ee8;
  font-size: 26rpx;
  font-weight: 900;
}

.history-record--single .history-record__result,
.history-record--waiting .history-record__result {
  color: #ff7469;
}

.history-record--invalid .history-record__result {
  color: #817d81;
}

.history-record__meta {
  margin-top: 8rpx;
  color: #817d81;
  font-size: 21rpx;
  font-weight: 800;
}

.history-cover {
  position: absolute;
  top: 50%;
  left: 36rpx;
  width: 140rpx;
  height: 140rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #ffd866;
  border: 5rpx solid #201b22;
  border-radius: 24rpx;
  transform: translateY(-50%);
}

.history-cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #817d81;
  font-size: 22rpx;
  font-weight: 800;
}

.feedback-page {
  padding-top: 34rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.feedback-guide {
  display: block;
  color: #6e6671;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.55;
}

.feedback-input {
  width: 100%;
  height: 378rpx;
  box-sizing: border-box;
  margin-top: 54rpx;
  padding: 32rpx 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.55;
}

.feedback-input__placeholder {
  color: #aaa2af;
  font-weight: 800;
}

.feedback-note {
  margin-top: 32rpx;
  padding: 32rpx 28rpx;
  color: #6e6671;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.55;
  background: #fff3d2;
}

.feedback-submit {
  position: fixed;
  right: 60rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  left: 60rpx;
  width: auto;
}

.settings-page {
  padding-top: 10rpx;
}

.settings-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 86rpx;
  margin-bottom: 10rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  font-weight: 900;
  text-align: left;
}

.settings-row__arrow {
  color: #817d81;
  font-size: 40rpx;
}

.settings-row__value {
  color: #817d81;
  font-size: 24rpx;
}

.settings-about {
  margin-top: 44rpx;
}
.history-pagination {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #766e78;
}
