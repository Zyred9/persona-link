<app-nav-bar
  title="{{viewTitle}}"
  show-back="{{true}}"
  custom-back="{{embedded}}"
  bind:back="handleBack"
></app-nav-bar>

<block wx:if="{{currentView === 'profile'}}">
  <view class="paper-page profile-page">
    <view class="paper-card profile-card">
      <view class="profile-face">
        <view class="profile-heart"></view>
        <view class="profile-cheek profile-cheek--left"></view>
        <view class="profile-cheek profile-cheek--right"></view>
        <view class="profile-smile"></view>
      </view>
      <view class="profile-copy">
        <text class="profile-badge">游客</text>
        <text class="profile-title">先从一题开始</text>
        <text class="profile-description">所有测试和双人配对均可免费体验</text>
      </view>
    </view>

    <view class="profile-menu">
      <button class="paper-card profile-row" bindtap="joinPair"><text>输入配对码</text><text class="profile-row__arrow">›</text></button>
      <button class="paper-card profile-row" data-view="history" bindtap="openAccountView">
        <text>测试记录</text>
        <text class="profile-row__hint">单人 / 双人</text>
      </button>
      <button class="paper-card profile-row" data-view="feedback" bindtap="openAccountView">
        <text>反馈与举报</text>
        <text class="profile-row__arrow">›</text>
      </button>
      <button class="paper-card profile-row" data-view="settings" bindtap="openAccountView">
        <text>设置</text>
        <text class="profile-row__arrow">›</text>
      </button>
    </view>
  </view>
</block>

<block wx:elif="{{currentView === 'history'}}">
  <view class="paper-page history-page">
    <view class="history-summary">
      <view class="history-summary__item history-summary__item--active">单人测试 {{historyState === 'error' ? '加载失败' : total}}</view>
      <view class="history-summary__item">双人配对 {{pairHistoryState === 'error' ? '加载失败' : pairTotal}}</view>
    </view>
    <text class="paper-section-title history-section-title">测试报告</text>
    <page-state wx:if="{{historyState === 'loading'}}" type="loading" title="单人记录正在加载"></page-state>
    <page-state wx:elif="{{historyState === 'error'}}" type="error" title="单人记录加载失败" description="{{historyErrorDescription}}" action-text="重新加载" bind:action="retrySingleHistory"></page-state>
    <view wx:elif="{{historyState === 'empty'}}" class="history-pagination">还没有单人测试记录</view>
    <block wx:else>
        <button
          wx:for="{{records}}"
          wx:key="reportId"
          class="paper-card history-record history-record--single"
          data-report-id="{{item.reportId}}"
          bindtap="handleRecordTap"
        >
          <view class="history-face" aria-hidden="true">
            <view class="history-face__eye history-face__eye--left"></view>
            <view class="history-face__eye history-face__eye--right"></view>
            <view class="history-face__cheek history-face__cheek--left"></view>
            <view class="history-face__cheek history-face__cheek--right"></view>
            <view class="history-face__smile"></view>
          </view>
          <view class="history-record__copy">
            <text class="history-record__title">{{item.title}}</text>
            <text class="history-record__result">{{item.resultName}}</text>
            <text class="history-record__meta">{{item.generatedAt}}{{item.versionLabel ? ' · ' + item.versionLabel : ''}}</text>
          </view>
          <view class="history-record__more" data-report-id="{{item.reportId}}" catchtap="deleteRecord">···</view>
        </button>

      <view class="history-pagination">
        <button wx:if="{{historyMoreError}}" class="paper-button" bindtap="retrySingleHistory">{{historyMoreError}} · 点击重试</button>
        <text wx:elif="{{historyLoadingMore}}">正在加载更多单人记录…</text>
        <button wx:elif="{{historyHasMore}}" class="paper-button" bindtap="retrySingleHistory">加载更多单人记录</button>
        <text wx:else>已加载全部单人记录</text>
      </view>
    </block>
    <text class="paper-section-title history-section-title">双人配对</text>
    <page-state wx:if="{{pairHistoryState === 'loading'}}" type="loading" title="双人记录正在加载"></page-state>
    <page-state wx:elif="{{pairHistoryState === 'error'}}" type="error" title="双人记录加载失败" description="{{pairHistoryErrorDescription}}" action-text="重新加载" bind:action="retryPairHistory"></page-state>
    <view wx:elif="{{pairHistoryState === 'empty'}}" class="history-pagination">还没有双人配对记录</view>
    <block wx:else>
        <button
          wx:for="{{pairRecords}}"
          wx:key="pairSessionId"
          class="paper-card history-record history-record--pair {{item.waiting ? 'history-record--waiting' : ''}}"
          data-pair-session-id="{{item.pairSessionId}}"
          data-report-ready="{{item.reportReady}}"
          bindtap="handlePairTap"
        >
          <view class="history-record__copy">
            <text class="history-record__title">{{item.title}}</text>
            <text class="history-record__result">{{item.resultText}}</text>
            <text class="history-record__meta">{{item.meta}} · {{item.reportReady ? '查看报告' : '查看进度'}}</text>
          </view>
        </button>

      <view class="history-pagination">
        <button wx:if="{{pairHistoryMoreError}}" class="paper-button" bindtap="retryPairHistory">{{pairHistoryMoreError}} · 点击重试</button>
        <text wx:elif="{{pairHistoryLoadingMore}}">正在加载更多双人记录…</text>
        <button wx:elif="{{pairHistoryHasMore}}" class="paper-button" bindtap="retryPairHistory">加载更多双人记录</button>
        <text wx:else>已加载全部双人记录</text>
      </view>
    </block>
  </view>
</block>

<block wx:elif="{{currentView === 'feedback'}}">
  <view class="paper-page feedback-page">
    <text class="feedback-guide">请描述问题或不适内容。请勿提交他人的敏感资料或原始答题内容。</text>

    <textarea
      class="paper-card feedback-input"
      value="{{feedbackContent}}"
      disabled="{{feedbackSubmitting}}"
      maxlength="500"
      placeholder="请填写反馈内容（必填）"
      placeholder-class="feedback-input__placeholder"
      bindinput="handleFeedbackInput"
    ></textarea>

    <view class="paper-card feedback-note">
      提交成功后会清空已填写内容；提交失败时保留已填写内容，可重试。
    </view>

    <button class="paper-button paper-button--primary feedback-submit" loading="{{feedbackSubmitting}}" disabled="{{feedbackSubmitting}}" bindtap="submitFeedback">{{feedbackSubmitting ? '正在提交' : '提交反馈'}}</button>
  </view>
</block>

<block wx:else>
  <view class="paper-page settings-page">
    <text class="paper-section-title">隐私与数据</text>

    <button class="paper-card settings-row" bindtap="openPrivacy">
      <text>隐私与数据</text>
      <text class="settings-row__arrow">›</text>
    </button>
    <button class="paper-card settings-row" data-type="userAgreement" bindtap="openLegal">
      <text>用户协议</text>
      <text class="settings-row__arrow">›</text>
    </button>
    <button class="paper-card settings-row" data-type="privacyGuide" bindtap="openLegal">
      <text>隐私保护指引</text>
      <text class="settings-row__arrow">›</text>
    </button>
    <button class="paper-card settings-row" data-type="disclaimer" bindtap="openLegal">
      <text>娱乐测试免责声明</text>
      <text class="settings-row__arrow">›</text>
    </button>

    <text class="paper-section-title settings-about">关于</text>
    <view class="paper-card settings-row">
      <text>版本信息</text>
      <text class="settings-row__value">{{versionLabel}}</text>
    </view>
  </view>
</block>
