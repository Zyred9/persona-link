page { height: 100%; overflow: hidden; }

.privacy-page {
  padding-top: 46rpx;
}

.privacy-intro {
  padding: 38rpx 28rpx;
}

.privacy-intro__title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
}

.privacy-intro__copy {
  display: block;
  margin-top: 18rpx;
  color: #6e6671;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.6;
}

.privacy-list {
  margin-top: 40rpx;
}

.privacy-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 86rpx;
  margin-bottom: 10rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
  font-weight: 900;
  text-align: left;
}

.privacy-row__value,
.privacy-row__arrow {
  color: #817d81;
  font-size: 24rpx;
}

.privacy-row__arrow {
  font-size: 40rpx;
}

.privacy-row--danger {
  color: #ce5d58;
}

.privacy-note {
  margin-top: 50rpx;
  padding: 32rpx 28rpx;
  color: #6e6671;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.55;
  background: #fff3d2;
}
