.member-page {
  padding-top: 30rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.member-hero {
  display: flex;
  min-height: 274rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
  padding: 38rpx 36rpx;
  color: #fffdf8;
  background: #493663;
  border-radius: 34rpx;
}

.member-hero__eyebrow {
  color: #ffd866;
  font-size: 25rpx;
  font-weight: 900;
}

.member-hero__title {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.3;
}

.member-hero__copy {
  margin-top: 28rpx;
  color: #e5d9f0;
  font-size: 21rpx;
  font-weight: 800;
}

.member-plan {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 104rpx;
  margin-top: 44rpx;
  padding: 20rpx 24rpx;
  text-align: left;
}

.member-plan + .member-plan {
  margin-top: 22rpx;
}

.member-plan__radio {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 auto;
  border: 4rpx solid #201b22;
  border-radius: 50%;
}

.member-plan--selected .member-plan__radio {
  background: #945ee8;
  box-shadow: inset 0 0 0 6rpx #fffdf8;
}

.member-plan__copy {
  display: flex;
  flex-direction: column;
  margin-left: 28rpx;
}

.member-plan__title {
  font-size: 28rpx;
  font-weight: 900;
}

.member-plan__description {
  margin-top: 8rpx;
  color: #817d81;
  font-size: 21rpx;
  font-weight: 800;
}

.member-confirm {
  position: fixed;
  right: 60rpx;
  bottom: calc(44rpx + env(safe-area-inset-bottom));
  left: 60rpx;
  width: auto;
}

.login-gate {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  padding: calc(44rpx + env(safe-area-inset-top)) 60rpx calc(40rpx + env(safe-area-inset-bottom));
  background-color: #fffaf1;
  background-image:
    linear-gradient(rgba(62, 53, 63, 0.055) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(62, 53, 63, 0.055) 1rpx, transparent 1rpx);
  background-size: 28rpx 28rpx;
}

.login-gate__header {
  font-size: 31rpx;
  font-weight: 900;
}

.login-gate__portrait {
  display: flex;
  width: 100%;
  min-height: 230rpx;
  align-items: center;
  justify-content: center;
  margin-top: 58rpx;
}

.login-face {
  position: relative;
  width: 126rpx;
  height: 126rpx;
  background: #ffd866;
  border: 5rpx solid #201b22;
  border-radius: 50%;
}

.login-face__eye {
  position: absolute;
  top: 54rpx;
  width: 15rpx;
  height: 15rpx;
  background: #201b22;
  border-radius: 50%;
}

.login-face__eye--left {
  left: 35rpx;
}

.login-face__eye--right {
  right: 35rpx;
}

.login-face__smile {
  position: absolute;
  bottom: 28rpx;
  left: 50%;
  width: 38rpx;
  height: 19rpx;
  border-bottom: 5rpx solid #201b22;
  border-radius: 0 0 30rpx 30rpx;
  transform: translateX(-50%);
}

.login-gate__title {
  margin-top: 94rpx;
  font-size: 38rpx;
  font-weight: 900;
  text-align: center;
}

.login-gate__copy {
  margin-top: 24rpx;
  color: #6e6671;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.65;
  text-align: center;
}

.login-gate__actions {
  width: 100%;
  margin-top: auto;
}

.login-gate__later {
  margin-top: 16rpx;
}
