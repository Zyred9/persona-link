<app-nav-bar title="会员中心" show-back="{{true}}"></app-nav-bar>

<view class="paper-page member-page">
  <view class="member-hero">
    <text class="member-hero__eyebrow">心动会员</text>
    <view class="member-hero__title">
      <text>把深度内容留给</text>
      <text>想了解更多的你</text>
    </view>
    <text class="member-hero__copy">会员配置范围内，深度解析直接可见，免激励视频</text>
  </view>

  <button
    class="paper-card member-plan {{selectedPlan === 'monthly' ? 'member-plan--selected' : ''}}"
    data-plan="monthly"
    bindtap="selectPlan"
  >
    <view class="member-plan__radio"></view>
    <view class="member-plan__copy">
      <text class="member-plan__title">月度会员</text>
      <text class="member-plan__description">价格与周期由后台配置</text>
    </view>
  </button>
  <button
    class="paper-card member-plan {{selectedPlan === 'single' ? 'member-plan--selected' : ''}}"
    data-plan="single"
    bindtap="selectPlan"
  >
    <view class="member-plan__radio"></view>
    <view class="member-plan__copy">
      <text class="member-plan__title">单次报告权益</text>
      <text class="member-plan__description">如后台为当前题型配置</text>
    </view>
  </button>

  <button class="paper-button paper-button--primary member-confirm" bindtap="confirmOpen">确认开通</button>
</view>

<view wx:if="{{showLoginGate}}" class="login-gate">
  <view class="login-gate__header">测试结果</view>
  <view class="paper-card login-gate__portrait" aria-hidden="true">
    <view class="login-face">
      <view class="login-face__eye login-face__eye--left"></view>
      <view class="login-face__eye login-face__eye--right"></view>
      <view class="login-face__smile"></view>
    </view>
  </view>

  <text class="login-gate__title">登录后再开通会员</text>
  <text class="login-gate__copy">基础测试不需要登录。为确认支付、会员和跨设备权益，需要完成微信可恢复身份绑定。</text>

  <view class="login-gate__actions">
    <button class="paper-button paper-button--primary" bindtap="continueLogin">继续授权登录</button>
    <button class="paper-button login-gate__later" bindtap="stayGuest">暂不登录</button>
  </view>
</view>
