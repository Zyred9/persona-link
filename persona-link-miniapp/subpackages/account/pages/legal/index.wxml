<app-nav-bar title="{{document.title}}" show-back="{{true}}"></app-nav-bar>

<view class="paper-page legal-page">
  <text class="legal-title">{{document.title}}</text>
  <text wx:if="{{state === 'ready' && document.updatedAt}}" class="legal-kicker">更新于 {{document.updatedAt}}</text>

  <view class="paper-card legal-card">
    <rich-text wx:if="{{state === 'ready'}}" class="legal-paragraph" nodes="{{contentNodes}}" user-select="{{true}}"></rich-text>
    <text wx:elif="{{state === 'loading'}}">正在加载协议…</text>
    <view wx:else><text>{{error}}</text><button class="paper-button" bindtap="loadDocument">重新加载</button></view>
  </view>

</view>
