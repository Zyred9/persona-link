<app-nav-bar title="设置" show-back="{{true}}"></app-nav-bar>

<view class="paper-page settings-page">
  <text class="paper-section-title">隐私与数据</text>

  <button class="paper-card settings-row" bindtap="openPrivacy">
    <text>隐私与数据</text>
    <text class="settings-row__arrow">›</text>
  </button>
  <button class="paper-card settings-row" data-type="userAgreement" bindtap="openLegal">
    <text>用户协议</text>
    <text class="settings-row__arrow">›</text>
  </button>
  <button class="paper-card settings-row" data-type="privacyGuide" bindtap="openLegal">
    <text>隐私保护指引</text>
    <text class="settings-row__arrow">›</text>
  </button>
  <button class="paper-card settings-row" data-type="disclaimer" bindtap="openLegal">
    <text>娱乐测试免责声明</text>
    <text class="settings-row__arrow">›</text>
  </button>

  <text class="paper-section-title settings-about">关于</text>
  <view class="paper-card settings-row">
    <text>版本信息</text>
    <text class="settings-row__value">V1.0 原型</text>
  </view>
</view>
