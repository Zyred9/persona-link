<app-nav-bar title="测试记录" show-back="{{true}}"></app-nav-bar>

<view class="paper-page history-page">
  <page-state
    wx:if="{{state === 'loading'}}"
    type="loading"
    title="测试记录正在加载"
  ></page-state>

  <page-state
    wx:elif="{{state === 'error'}}"
    type="error"
    title="记录加载失败"
    description="{{errorDescription}}"
    action-text="重新加载"
    bind:action="retry"
  ></page-state>

  <page-state
    wx:elif="{{state === 'empty'}}"
    type="empty"
    title="还没有测试记录"
    description="完成测试或创建配对后，记录会出现在这里。"
    action-text="刷新一下"
    bind:action="retry"
  ></page-state>

  <block wx:else>
    <view class="history-summary" aria-label="单人测试 {{total}} 条">
      <view class="history-summary__item history-summary__item--active">单人测试 {{total}}</view>
      <view class="history-summary__item">双人配对 {{pairTotal}}</view>
    </view>

    <block wx:if="{{total > 0}}">
      <text class="paper-section-title history-section-title">{{singleSectionTitle}}</text>
      <button
        wx:for="{{records}}"
        wx:key="reportId"
        class="paper-card history-record history-record--single"
        data-report-id="{{item.reportId}}"
        bindtap="handleRecordTap"
      >
        <view class="history-face" aria-hidden="true">
          <view class="history-face__eye history-face__eye--left"></view>
          <view class="history-face__eye history-face__eye--right"></view>
          <view class="history-face__cheek history-face__cheek--left"></view>
          <view class="history-face__cheek history-face__cheek--right"></view>
          <view class="history-face__smile"></view>
        </view>
        <view class="history-record__copy">
          <text class="history-record__title">{{item.title}}</text>
          <text class="history-record__result">{{item.resultName}}</text>
          <text class="history-record__meta">{{item.generatedAt}}{{item.versionLabel ? ' · ' + item.versionLabel : ''}}</text>
        </view>
        <view class="history-record__more" data-report-id="{{item.reportId}}" catchtap="deleteRecord">···</view>
      </button>
    </block>

    <block wx:if="{{pairTotal > 0}}">
      <text class="paper-section-title history-section-title">{{pairSectionTitle}}</text>
      <button
        wx:for="{{pairRecords}}"
        wx:key="pairSessionId"
        class="paper-card history-record history-record--pair {{item.waiting ? 'history-record--waiting' : ''}}"
        data-pair-session-id="{{item.pairSessionId}}"
        data-report-ready="{{item.reportReady}}"
        bindtap="handlePairTap"
      >
        <view class="history-record__copy">
          <text class="history-record__title">{{item.title}}</text>
          <text class="history-record__result">{{item.resultText}}</text>
          <text class="history-record__meta">{{item.meta}} · {{item.reportReady ? '查看报告' : '查看进度'}}</text>
        </view>
      </button>
    </block>
  </block>
</view>
