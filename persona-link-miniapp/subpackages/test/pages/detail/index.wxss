.detail-page {
  display: flex;
  min-height: calc(100vh - 120rpx);
  flex-direction: column;
}

.detail-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 286rpx;
  margin-top: 28rpx;
  padding: 34rpx 34rpx 34rpx 36rpx;
  background: #fff0a8;
}

.detail-hero__title {
  max-width: 340rpx;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.25;
  white-space: pre-line;
}

.detail-hero__title text,
.error-description text {
  display: block;
}

.face {
  position: relative;
  flex: 0 0 auto;
  width: 142rpx;
  height: 142rpx;
  border: 5rpx solid #201b22;
  border-radius: 50%;
}

.face--yellow {
  background: #ffda68;
}

.face--purple {
  background: #ba91f6;
}

.face__eye {
  position: absolute;
  top: 55rpx;
  width: 17rpx;
  height: 17rpx;
  background: #201b22;
  border-radius: 50%;
}

.face__eye--left {
  left: 42rpx;
}

.face__eye--right {
  right: 42rpx;
}

.face__cheek {
  position: absolute;
  top: 80rpx;
  width: 20rpx;
  height: 20rpx;
  background: #f5b1c5;
  border-radius: 50%;
}

.face__cheek--left {
  left: 18rpx;
}

.face__cheek--right {
  right: 18rpx;
}

.face__smile {
  position: absolute;
  top: 75rpx;
  left: 50%;
  width: 44rpx;
  height: 25rpx;
  border-bottom: 5rpx solid #201b22;
  border-radius: 50%;
  transform: translateX(-50%);
}

.detail-tags {
  display: flex;
  gap: 14rpx;
  margin-top: 34rpx;
}

.detail-tag {
  min-width: 128rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
  border: 4rpx solid #201b22;
  border-radius: 999rpx;
}

.detail-tag--yellow {
  background: #ffd86a;
}

.detail-tag--purple {
  background: #c7a5ff;
}

.detail-tag--mint {
  background: #a9e2cf;
}

.detail-title {
  margin-top: 26rpx;
  font-size: 39rpx;
  font-weight: 900;
  line-height: 1.35;
}

.detail-description {
  margin-top: 10rpx;
  color: #6e6671;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-rules {
  display: flex;
  gap: 24rpx;
  margin-top: 62rpx;
  padding: 38rpx 30rpx;
  flex-direction: column;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.detail-action {
  margin-top: auto;
  margin-bottom: 4rpx;
}

.detail-page--error {
  align-items: stretch;
}

.error-hero {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 274rpx;
  margin-top: 28rpx;
  background: #e5d7ff;
}

.error-copy {
  display: flex;
  align-items: center;
  margin-top: 92rpx;
  flex-direction: column;
  text-align: center;
}

.error-title {
  font-size: 40rpx;
  font-weight: 900;
}

.error-description {
  margin-top: 22rpx;
  color: #6e6671;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.65;
  white-space: pre-line;
}
