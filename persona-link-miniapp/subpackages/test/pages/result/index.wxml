<app-nav-bar title="测试结果" show-back="{{true}}"></app-nav-bar>

<view wx:if="{{state === 'loading'}}" class="paper-page result-page">
  <page-state type="loading" title="测试报告正在加载"></page-state>
</view>

<view wx:elif="{{state === 'error'}}" class="paper-page result-page">
  <page-state type="error" title="报告加载失败" description="{{errorDescription}}" action-text="重新加载" bind:action="retry"></page-state>
</view>

<view wx:elif="{{state === 'locked'}}" class="paper-page result-page">
  <page-state title="测试结果已生成" description="{{adDescription}}" action-text="{{adAction}}" bind:action="watchAd"></page-state>
</view>

<view wx:elif="{{view === 'result'}}" class="paper-page result-page">
  <view class="result-card paper-card">
    <view class="result-card__top">
      <view class="result-card__summary">
        <text class="result-badge">你的类型是</text>
        <text class="result-name">{{result.name}}</text>
        <text class="result-description">{{result.description}}</text>
      </view>
      <view class="result-face"><view class="result-face__eye result-face__eye--left"></view><view class="result-face__eye result-face__eye--right"></view><view class="result-face__cheek result-face__cheek--left"></view><view class="result-face__cheek result-face__cheek--right"></view><view class="result-face__smile"></view></view>
    </view>
    <view wx:for="{{result.dimensions}}" wx:key="dimensionId" class="score-row">
      <text class="score-row__label">{{item.dimensionName}}</text><view class="score-row__track"><view class="score-row__bar score-row__bar--{{item.barTone}}" style="width: {{item.normalizedScore}}%;"></view></view><text class="score-row__value">{{item.normalizedScore}}</text>
    </view>
  </view>

  <view wx:if="{{result.deepDescription}}" class="deep-result-card paper-card">
    <text class="deep-result-title">深度解读与成长建议</text>
    <text class="deep-result-copy">{{result.deepDescription}}</text>
  </view>

  <button class="paper-button result-share" open-type="share">分享结果</button>
</view>

<view wx:else class="paper-page state-page state-page--permission">
  <view class="permission-card paper-card"><view class="permission-icon"><view></view></view></view>
  <text class="state-title">未获得相册权限</text>
  <view class="state-description">
    <text>你可以在微信设置中开启相册保存权限；</text>
    <text>拒绝不影响查看或分享结果。</text>
  </view>
  <view class="state-actions">
    <button class="paper-button" bindtap="returnResult">知道了</button>
  </view>
</view>
