.result-page,
.state-page {
  display: flex;
  min-height: calc(100vh - 120rpx);
  flex-direction: column;
}

.result-card {
  min-height: 472rpx;
  margin-top: 28rpx;
  padding: 24rpx 28rpx 34rpx;
}

.result-card__summary {
  text-align: center;
}

.result-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  font-weight: 900;
  background: #ffd86a;
  border: 4rpx solid #201b22;
  border-radius: 999rpx;
}

.result-name {
  display: block;
  margin-top: 36rpx;
  margin-bottom: 28rpx;
  font-size: 46rpx;
  font-weight: 900;
}

.result-description {
  display: block;
  margin-top: 10rpx;
  color: #6e6671;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.5;
  text-align: left;
  white-space: pre-line;
}

.state-description text {
  display: block;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 28rpx;
}

.score-row__label {
  width: 102rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.score-row__track {
  flex: 1;
  height: 20rpx;
  overflow: hidden;
  background: #e9e5e2;
  border-radius: 999rpx;
}

.score-row__bar {
  height: 100%;
  border-radius: inherit;
}

.score-row__bar--coral {
  background: #ff7469;
}

.score-row__bar--mint {
  background: #a9e2cf;
}

.score-row__value {
  width: 52rpx;
  font-size: 29rpx;
  font-weight: 900;
  text-align: right;
}

.deep-result-card {
  margin-top: 32rpx;
  padding: 26rpx 28rpx 22rpx;
  background: #e7d8ff;
}

.deep-result-title {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
}

.deep-result-copy {
  display: block;
  margin-top: 10rpx;
  color: #6e6671;
  font-size: 22rpx;
  font-weight: 700;
}

.result-share {
  margin-top: auto;
  margin-bottom: calc(84rpx + env(safe-area-inset-bottom));
}

.state-actions {
  margin-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.permission-card {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 274rpx;
  margin-top: 28rpx;
}

.permission-card {
  background: #e7d8ff;
}

.permission-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border: 7rpx solid #945ee8;
}

.permission-icon view {
  width: 30rpx;
  height: 30rpx;
  background: #945ee8;
}

.state-title {
  margin-top: 74rpx;
  font-size: 40rpx;
  font-weight: 900;
  text-align: center;
}

.state-description {
  margin-top: 22rpx;
  color: #6e6671;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.65;
  text-align: center;
  white-space: pre-line;
}

.state-actions {
  display: flex;
  gap: 20rpx;
  margin-top: auto;
  flex-direction: column;
}

.state-page--permission {
  padding-top: 30rpx;
}

.state-page--permission .state-title {
  margin-top: 42rpx;
}
