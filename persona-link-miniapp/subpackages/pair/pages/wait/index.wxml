<app-nav-bar title="配对进度" show-back="{{true}}"></app-nav-bar>

<view class="paper-page wait-page">
  <image
    wx:if="{{state === 'ready' && !invalid && (bothCompleted ? completedHeroImageUrl : waitingHeroImageUrl)}}"
    class="wait-hero"
    src="{{bothCompleted ? completedHeroImageUrl : waitingHeroImageUrl}}"
    data-field="{{bothCompleted ? 'completedHeroImageUrl' : 'waitingHeroImageUrl'}}"
    data-url="{{bothCompleted ? completedHeroImageUrl : waitingHeroImageUrl}}"
    mode="widthFix"
    binderror="handleHeroImageError"
  ></image>

  <page-state wx:if="{{state === 'loading'}}" type="loading" title="配对状态正在加载"></page-state>
  <page-state wx:elif="{{state === 'error'}}" type="error" title="配对状态加载失败" description="{{errorDescription}}" action-text="重新加载" bind:action="refreshStatus"></page-state>
  <block wx:else>
  <text class="wait-title">{{waitTitle}}</text>

  <view class="paper-card wait-note-card">
    <text class="wait-note-card__title">双方独立作答，不展示彼此答案</text>
    <text class="wait-note-card__copy">仅显示已完成 / 待完成状态</text>
  </view>

  <view class="wait-actions">
    <button
      wx:if="{{canReshare}}"
      class="paper-button paper-button--primary"
      open-type="share"
    >分享</button>
    <button
      wx:if="{{canReshare}}"
      class="paper-button wait-copy"
      bindtap="copyPairCode"
    >复制配对码 {{inviteCode}}</button>
    <button
      wx:if="{{!reportReady}}"
      class="paper-button {{canReshare ? 'wait-refresh' : 'paper-button--primary'}}"
      bindtap="refreshStatus"
    >刷新状态</button>
    <button
      wx:else
      class="paper-button paper-button--primary"
      bindtap="viewResult"
    >查看双人报告</button>
    <button wx:if="{{canCancel}}" class="paper-button wait-cancel" bindtap="cancelPair">取消本次配对</button>
  </view>
  </block>
</view>
