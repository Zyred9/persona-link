.home-page {
  position: relative;
  padding-right: 28rpx;
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
  padding-left: 28rpx;
}

.home-hero {
  padding: 28rpx 0 0;
}

.home-title-image {
  display: block;
  width: 100%;
}

.home-test-card {
  display: block;
  width: 100%;
  line-height: 1;
}

.home-test-card--focus {
  width: auto;
  margin-top: 28rpx;
}

.test-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28rpx;
  margin-top: 28rpx;
}

.all-test-grid {
  margin-top: 56rpx;
}

.home-test-card__image {
  display: block;
  width: 100%;
}

.category-list {
  display: flex;
  gap: 28rpx;
  margin: 56rpx 0 0;
  overflow-x: auto;
  padding: 0;
  white-space: nowrap;
}

.category {
  position: relative;
  flex: 0 0 auto;
  min-width: 138rpx;
  box-sizing: border-box;
  padding: 12rpx 16rpx;
  overflow: visible;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.1;
  background: #fffdf8;
  border: 3rpx solid #201b22;
  border-radius: 999rpx;
}

.category--active {
  background: #d8bafd;
  transform: rotate(-1deg);
}

.category--active::before,
.category--active::after {
  position: absolute;
  content: '';
  background: #201b22;
  border-radius: 999rpx;
}

.category--active::before {
  top: -17rpx;
  left: 3rpx;
  width: 3rpx;
  height: 11rpx;
  transform: rotate(-12deg);
}

.category--active::after {
  top: -9rpx;
  left: -11rpx;
  width: 11rpx;
  height: 3rpx;
  box-shadow: -5rpx 7rpx 0 #201b22;
  transform: rotate(40deg);
}

.category-empty {
  padding: 60rpx 0;
  color: #7f7a7f;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.home-intro {
  padding-top: 48rpx;
}

.home-kicker {
  display: block;
  color: #945ee8;
  font-size: 25rpx;
  font-weight: 900;
}

.home-title-image--loading {
  margin-top: 24rpx;
}

.home-detail-scroll {
  height: 100%;
  background-color: #fffaf1;
  background-image:
    linear-gradient(rgba(62, 53, 63, 0.055) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(62, 53, 63, 0.055) 1rpx, transparent 1rpx);
  background-size: 28rpx 28rpx;
}

.home-quiz-scroll {
  height: 100%;
  background-color: #fffaf1;
  background-image:
    linear-gradient(rgba(62, 53, 63, 0.055) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(62, 53, 63, 0.055) 1rpx, transparent 1rpx);
  background-size: 28rpx 28rpx;
}

.continue-card {
  position: absolute;
  z-index: 2;
  top: 20rpx;
  right: 28rpx;
  left: 28rpx;
  display: grid;
  grid-template-columns: 1fr auto auto;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 0;
  padding: 20rpx;
}

.continue-card__title,
.continue-card__meta {
  display: block;
}

.continue-card__title {
  font-weight: 700;
}

.continue-card__meta {
  margin-top: 6rpx;
  color: #777;
  font-size: 22rpx;
}
