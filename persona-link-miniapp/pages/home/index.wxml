<app-nav-bar title="映见你我" brand="{{true}}"></app-nav-bar>

<view class="paper-page home-page">
  <block wx:if="{{state === 'ready'}}">
    <view wx:if="{{currentAssessment}}" class="paper-card continue-card">
      <view><text class="continue-card__title">继续上次测试</text><text class="continue-card__meta">{{currentAssessment.title}} · 已完成 {{currentAssessment.completedCount}}/{{currentAssessment.totalCount}}</text></view>
      <button class="paper-button paper-button--primary" disabled="{{abandoningAssessment}}" bindtap="continueAssessment">继续</button>
      <button class="paper-button" disabled="{{abandoningAssessment}}" bindtap="abandonAssessment">作废</button>
    </view>
    <view class="home-hero">
      <image class="home-title-image paper-card" src="{{titleImageUrl}}" mode="widthFix" binderror="handleTitleImageError"></image>
    </view>

    <view
      wx:if="{{focusTest}}"
      class="home-test-card home-test-card--focus"
      data-id="{{focusTest.testId}}"
      data-type="{{focusTest.testType}}"
      bindtap="openTest"
    >
      <image class="home-test-card__image" src="{{focusTest.imageUrl}}" mode="widthFix" webp="{{true}}"></image>
    </view>

    <view wx:if="{{recommendedTests.length > 0}}" class="test-grid">
      <button
        wx:for="{{recommendedTests}}"
        wx:key="testId"
        class="home-test-card"
        data-id="{{item.testId}}"
        data-type="{{item.testType}}"
        bindtap="openTest"
      >
        <image class="home-test-card__image" src="{{item.imageUrl}}" mode="widthFix" webp="{{true}}" lazy-load="{{true}}"></image>
      </button>
    </view>

    <view class="category-list">
      <button
        wx:for="{{categories}}"
        wx:key="categoryId"
        class="category {{selectedCategoryId === item.categoryId ? 'category--active' : ''}}"
        data-category-id="{{item.categoryId}}"
        bindtap="selectCategory"
      >{{item.categoryName}}</button>
    </view>

    <view wx:if="{{tests.length > 0}}" class="test-grid all-test-grid">
      <button
        wx:for="{{tests}}"
        wx:key="testId"
        class="home-test-card"
        data-id="{{item.testId}}"
        data-type="{{item.testType}}"
        bindtap="openTest"
      >
        <image class="home-test-card__image paper-card" src="{{item.imageUrl}}" mode="widthFix" webp="{{true}}" lazy-load="{{true}}"></image>
      </button>
    </view>

    <view wx:if="{{tests.length === 0}}" class="category-empty">这个分类还在准备中</view>
  </block>

  <block wx:elif="{{state === 'loading'}}">
    <view class="home-intro">
      <text class="home-kicker">今日刚好适合认识自己</text>
      <image class="home-title-image home-title-image--loading paper-card" src="{{titleImageUrl}}" mode="widthFix" binderror="handleTitleImageError"></image>
    </view>
    <page-state type="loading" title="内容正在加载"></page-state>
  </block>

  <page-state
    wx:elif="{{state === 'empty'}}"
    type="empty"
    title="暂时没有可用测试"
    description="{{emptyDescription}}"
    action-text="刷新一下"
    bind:action="loadHome"
  ></page-state>

  <page-state
    wx:else
    type="error"
    title="内容暂时加载失败"
    description="{{errorDescription}}"
    action-text="重新加载"
    bind:action="loadHome"
  ></page-state>
</view>

<page-container
  show="{{containerVisible}}"
  duration="{{containerMode === 'detail' ? 180 : 80}}"
  position="right"
  overlay="{{false}}"
  custom-style="width: 100%; height: 100%; background: #fffaf1;"
  bind:beforeleave="deactivateContainer"
  bind:afterleave="clearContainer"
>
  <scroll-view class="{{containerMode === 'quiz' ? 'home-quiz-scroll' : 'home-detail-scroll'}}" catchtouchmove="blockContainerScroll" bindscrolltolower="loadMoreAccountRecords">
    <account-center
      id="home-account-center"
      wx:if="{{containerMode === 'account'}}"
      embedded="{{true}}"
      bind:close="closeAccount"
      bind:viewchange="handleAccountViewChange"
    ></account-center>
    <block wx:elif="{{containerMode === 'quiz'}}">
      <app-nav-bar
        title="{{activeTestType === 2 ? '双人测试' : '单人测试'}}"
        show-back="{{true}}"
        custom-back="{{true}}"
        bind:back="closeQuiz"
      ></app-nav-bar>
      <quiz-runner
        id="home-quiz-runner"
        bind:back="closeQuiz"
        bind:finish="finishQuiz"
      ></quiz-runner>
    </block>
    <block wx:else>
      <app-nav-bar
        title="测试详情"
        show-back="{{true}}"
        custom-back="{{true}}"
        bind:back="closeTestDetail"
      ></app-nav-bar>
      <test-detail id="home-test-detail" test-id="{{activeTestId}}" test-type="{{activeTestType}}" bind:back="closeTestDetail"></test-detail>
    </block>
  </scroll-view>
</page-container>
