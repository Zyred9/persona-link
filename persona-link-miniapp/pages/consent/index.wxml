<app-nav-bar title=""></app-nav-bar>

<view class="paper-page consent-page">
  <view class="consent-hero">
    <view>
      <text class="consent-kicker">心动测测</text>
      <view class="consent-title">
        <text>先说好，</text>
        <text>再一起玩。</text>
      </view>
    </view>
    <view class="heart-mascot">
      <view class="heart-mascot__heart"></view>
      <view class="heart-mascot__cheek heart-mascot__cheek--left"></view>
      <view class="heart-mascot__cheek heart-mascot__cheek--right"></view>
      <view class="heart-mascot__smile"></view>
    </view>
  </view>

  <view class="paper-card consent-card">
    <text class="consent-card__title">这是娱乐测试，不是判断。</text>
    <text class="consent-card__copy">结果只供娱乐和自我了解参考，不构成心理、医疗、婚恋或职业建议。</text>
  </view>

  <view class="consent-legal">
    <text>继续前，请阅读并同意</text>
    <text class="consent-link" data-type="userAgreement" bindtap="openLegal">《用户协议》</text>
    <text>、</text>
    <text class="consent-link" data-type="privacyGuide" bindtap="openLegal">《隐私保护指引》</text>
    <text>与</text>
    <text class="consent-link" data-type="disclaimer" bindtap="openLegal">《娱乐测试免责声明》</text>
    <text>。</text>
  </view>

  <view class="consent-actions">
    <text wx:if="{{state === 'error'}}">{{error}}</text>
    <button wx:if="{{state === 'error'}}" class="paper-button" bindtap="loadDocuments">重新加载协议</button>
    <button class="paper-button paper-button--primary" disabled="{{state !== 'ready'}}" loading="{{state === 'loading'}}" bindtap="agreeAndContinue">{{state === 'loading' ? '正在加载协议' : '同意并继续'}}</button>
    <button class="consent-exit" bindtap="exitMiniProgram">不同意并退出</button>
  </view>
</view>
