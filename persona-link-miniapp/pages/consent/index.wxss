.consent-page {
  display: flex;
  min-height: calc(100vh - 120rpx);
  flex-direction: column;
}

.onboarding-panel { display: block; margin-top: 70rpx; }
.onboarding-avatar::after { border: 0; }
.onboarding-panel .paper-button { margin-top: 36rpx; }
.onboarding-avatar { width: 200rpx; height: 200rpx; padding: 0; border: 3rpx solid #201b22; border-radius: 50%; background: #fff7ec; font-size: 24rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.onboarding-avatar image { width: 100%; height: 100%; }
.onboarding-nickname { height: 90rpx; margin: 36rpx 0; padding: 0 24rpx; border: 2rpx solid #201b22; border-radius: 20rpx; background: #fffdf8; }
.onboarding-error { display: block; margin-top: 24rpx; color: #b63232; font-size: 26rpx; }

.consent-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
}

.consent-kicker {
  display: block;
  color: #945ee8;
  font-size: 28rpx;
  font-weight: 900;
}

.consent-title {
  display: flex;
  flex-direction: column;
  margin-top: 34rpx;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.35;
  white-space: pre-line;
}

.heart-mascot {
  position: relative;
  width: 142rpx;
  height: 142rpx;
  margin-top: 34rpx;
  align-self: flex-end;
  margin-bottom: -20rpx;
  background: #c7a5ff;
  border: 5rpx solid #201b22;
  border-radius: 50%;
}

.heart-mascot__heart {
  position: absolute;
  top: 42rpx;
  left: 50%;
  width: 46rpx;
  height: 46rpx;
  box-sizing: border-box;
  background: #ff7469;
  border-right: 5rpx solid #201b22;
  border-bottom: 5rpx solid #201b22;
  transform: translateX(-50%) rotate(45deg);
}

.heart-mascot__heart::before,
.heart-mascot__heart::after {
  position: absolute;
  width: 46rpx;
  height: 46rpx;
  content: '';
  background: #ff7469;
  border: 5rpx solid #201b22;
  box-sizing: border-box;
}

.heart-mascot__heart::before {
  top: -23rpx;
  left: 0;
  height: 23rpx;
  border-bottom: 0;
  border-radius: 46rpx 46rpx 0 0;
}

.heart-mascot__heart::after {
  top: 0;
  left: -23rpx;
  width: 23rpx;
  border-right: 0;
  border-radius: 46rpx 0 0 46rpx;
}

.heart-mascot__cheek {
  position: absolute;
  bottom: 42rpx;
  width: 18rpx;
  height: 18rpx;
  background: #f5b1c5;
  border-radius: 50%;
}

.heart-mascot__cheek--left {
  left: 20rpx;
}

.heart-mascot__cheek--right {
  right: 20rpx;
}

.heart-mascot__smile {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  width: 44rpx;
  height: 22rpx;
  border-bottom: 5rpx solid #201b22;
  border-radius: 0 0 40rpx 40rpx;
  transform: translateX(-50%);
}

.consent-card {
  min-height: 258rpx;
  margin-top: 132rpx;
  padding: 34rpx 28rpx 38rpx;
}

.consent-card__title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
}

.consent-card__copy {
  display: block;
  margin-top: 24rpx;
  color: #6e6671;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.7;
}

.consent-legal {
  margin-top: 76rpx;
  color: #6e6671;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.65;
}

.consent-link {
  color: #60427e;
  text-decoration: underline;
}

.consent-actions {
  margin-top: auto;
  margin-bottom: 100rpx;
  padding-top: 70rpx;
}

.consent-exit {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  width: 100%;
  margin-top: 20rpx;
  min-height: 70rpx;
  line-height: 1.3;
  color: #7b767b;
  font-size: 26rpx;
  font-weight: 800;
}
